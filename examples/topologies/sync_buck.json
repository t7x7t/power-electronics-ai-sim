{
  "schema": "topology-descriptor-v1",
  "descriptor_version": "1.0",
  "topology_id": "example_sync_buck",
  "components": [
    {
      "component_id": "vin_source",
      "kind": "voltage_source",
      "ports": [
        {"port_id": "positive", "net_id": "vin", "direction": "output"},
        {"port_id": "negative", "net_id": "gnd", "direction": "passive"}
      ],
      "parameters": {"voltage_v": 12.0}
    },
    {
      "component_id": "high_carrier",
      "kind": "pulse_source",
      "ports": [
        {"port_id": "positive", "net_id": "pwm_h", "direction": "output"},
        {"port_id": "negative", "net_id": "gnd", "direction": "passive"}
      ],
      "parameters": {"switching_frequency_hz": 100000.0}
    },
    {
      "component_id": "low_carrier",
      "kind": "pulse_source",
      "ports": [
        {"port_id": "positive", "net_id": "pwm_l", "direction": "output"},
        {"port_id": "negative", "net_id": "gnd", "direction": "passive"}
      ],
      "parameters": {"switching_frequency_hz": 100000.0}
    },
    {
      "component_id": "high_switch",
      "kind": "voltage_controlled_switch",
      "ports": [
        {"port_id": "input", "net_id": "vin", "direction": "input"},
        {"port_id": "output", "net_id": "sw", "direction": "output"},
        {"port_id": "control", "net_id": "pwm_h", "direction": "control"}
      ],
      "parameters": {"on_resistance_ohm": 0.001, "off_resistance_ohm": 1000000000.0}
    },
    {
      "component_id": "low_switch",
      "kind": "voltage_controlled_switch",
      "ports": [
        {"port_id": "input", "net_id": "sw", "direction": "input"},
        {"port_id": "output", "net_id": "gnd", "direction": "output"},
        {"port_id": "control", "net_id": "pwm_l", "direction": "control"}
      ],
      "parameters": {"on_resistance_ohm": 0.001, "off_resistance_ohm": 1000000000.0}
    },
    {
      "component_id": "inductor",
      "kind": "inductor",
      "ports": [
        {"port_id": "input", "net_id": "sw", "direction": "passive"},
        {"port_id": "output", "net_id": "vout", "direction": "passive"}
      ],
      "parameters": {"inductance_h": 0.0001, "initial_current_a": 0.0}
    },
    {
      "component_id": "output_capacitor",
      "kind": "capacitor",
      "ports": [
        {"port_id": "positive", "net_id": "vout", "direction": "passive"},
        {"port_id": "negative", "net_id": "gnd", "direction": "passive"}
      ],
      "parameters": {"capacitance_f": 0.00047, "initial_voltage_v": 0.0}
    },
    {
      "component_id": "load",
      "kind": "resistor_load",
      "ports": [
        {"port_id": "positive", "net_id": "vout", "direction": "passive"},
        {"port_id": "negative", "net_id": "gnd", "direction": "passive"}
      ],
      "parameters": {"resistance_ohm": 10.0}
    }
  ],
  "nets": [
    {"net_id": "vin", "kind": "electrical"},
    {"net_id": "gnd", "kind": "reference"},
    {"net_id": "pwm_h", "kind": "control"},
    {"net_id": "pwm_l", "kind": "control"},
    {"net_id": "sw", "kind": "electrical"},
    {"net_id": "vout", "kind": "electrical"}
  ],
  "metadata": {
    "control": {"mode": "single_duty_complementary", "dead_time_s": 1e-7},
    "example": {
      "purpose": "synchronous buck: two gates derived from one duty, with dead time",
      "compile": {"duty": 0.5, "duration_s": 0.002}
    }
  }
}
