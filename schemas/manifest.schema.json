{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/power-electronics-ai-sim/manifest.schema.json",
  "title": "Power Electronics AI Simulation Manifest",
  "type": "object",
  "additionalProperties": true,
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}, "check_finding": {"type": "object", "additionalProperties": true, "required": ["rule_id", "category", "message", "severity", "passed", "evidence", "stop_requested"], "properties": {"rule_id": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "message": {"type": "string"}, "severity": {"enum": ["info", "warning", "error", "fatal"]}, "passed": {"type": "boolean"}, "evidence": {"type": "object"}, "stop_requested": {"type": "boolean"}, "plugin_id": {"type": ["string", "null"]}}}, "check_report": {"type": "object", "additionalProperties": true, "required": ["passed", "findings"], "properties": {"passed": {"type": "boolean"}, "findings": {"type": "array", "items": {"$ref": "#/$defs/check_finding"}}, "plugin_id": {"type": ["string", "null"]}, "rule_version": {"type": "string"}}}},
  "required": ["schema_version", "experiment_id", "run_id", "created_at", "source_commit", "branch", "working_tree_status", "environment", "provenance", "plant", "controller", "contracts", "timebase", "initial_state", "random_seed", "artifacts", "status", "qualification", "safety", "evidence_level"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}, "experiment_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}, "source_commit": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "working_tree_status": {"enum": ["clean", "dirty", "unknown"]},
    "environment": {"type": "object", "required": ["status", "runner", "python", "platform", "dependencies", "backends", "limitations"], "properties": {"status": {"enum": ["known", "partial", "unknown"]}, "runner": {"type": "object"}, "python": {"type": "object"}, "platform": {"type": "object"}, "dependencies": {"type": "object"}, "backends": {"type": "array"}, "limitations": {"type": "array", "items": {"type": "string"}}}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["status", "producer", "limitations"], "properties": {"status": {"enum": ["known", "unknown", "exploratory"]}, "producer": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}, "worktree_analysis_sha256": {"$ref": "#/$defs/hash"}, "source_commit": {"type": "string", "minLength": 1}, "plant_sha256": {"$ref": "#/$defs/hash"}, "controller_sha256": {"$ref": "#/$defs/hash"}, "environment_status": {"enum": ["known", "partial", "unknown"]}}}, "plant": {"type": "object", "additionalProperties": true, "required": ["id", "hash"], "properties": {"id": {"type": "string", "minLength": 1}, "hash": {"$ref": "#/$defs/hash"}}}, "controller": {"type": "object", "additionalProperties": true, "required": ["id", "hash"], "properties": {"id": {"type": "string", "minLength": 1}, "hash": {"$ref": "#/$defs/hash"}}},
    "contracts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}, "timebase": {"type": "object", "additionalProperties": true, "required": ["unit", "control_period_s", "duration_s"], "properties": {"unit": {"const": "s"}, "control_period_s": {"type": "number", "exclusiveMinimum": 0}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "plant_step_s": {"type": "number", "exclusiveMinimum": 0}, "sample_offset_s": {"type": "number", "minimum": 0}}},
    "initial_state": {"type": "object"}, "random_seed": {"type": ["integer", "null"], "minimum": 0}, "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}}, "manifest_sha256": {"$ref": "#/$defs/hash"}, "package_sha256": {"$ref": "#/$defs/hash"}, "worktree_analysis_sha256": {"$ref": "#/$defs/hash"}, "hashes": {"type": "object", "additionalProperties": false, "required": ["manifest_sha256", "package_sha256"], "properties": {"manifest_sha256": {"$ref": "#/$defs/hash"}, "package_sha256": {"$ref": "#/$defs/hash"}}}, "status": {"enum": ["CREATED", "RUNNING", "RUN_OK", "RUN_FAILED", "INCOMPLETE", "QUALIFIED", "DISQUALIFIED", "COMPARABLE", "LEARNING_ELIGIBLE", "LEARNING_UPDATED", "LEARNING_REJECTED"]}, "qualification": {"type": "object", "properties": {"passed": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}, "checks": {"$ref": "#/$defs/check_report"}}}, "safety": {"type": "object", "properties": {"passed": {"type": "boolean"}, "checks": {"$ref": "#/$defs/check_report"}, "validity": {"$ref": "#/$defs/check_report"}}}, "checks": {"type": "object"}, "failure": {"type": ["object", "null"]}, "evidence_level": {"enum": ["mechanism", "functional", "physical-performance", "research-safety"]}
  }
}
